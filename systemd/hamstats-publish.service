[Unit]
# Render the Ham Stats site from the PostgreSQL serving layer and push it.
#
# This unit was hand-written into /etc/systemd/system, owned by no package and no playbook,
# which is what needed fixing. The unit is packaged now; the code it runs deliberately still
# lives in the checkout, because hamstats-1 is where ham-stats is developed as well as
# published.
Description=Ham Stats publish to GitHub Pages
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ionis
WorkingDirectory=/srv/ionis/repos/ionis-hamstats
Environment=HOME=/srv/ionis
# Which GitHub App identity git-credential-ghapp mints as. Without it the helper defaults to
# bob and the push fails with "could not read Username".
Environment=FLEET_AGENT=hamstats
# Read-only DSN. publish only reads the serving layer; the refresh job holds the writer.
Environment=HAMSTATS_DB_FILE=/etc/hamstats/db-ro.dsn
# The checkout is both the code and the content. Pulling first keeps what runs in lockstep
# with main AND makes the commit publish is about to push a fast-forward.
# --ff-only: if the tree has diverged, fail here rather than start a merge nobody will see.
ExecStartPre=/usr/bin/git -C /srv/ionis/repos/ionis-hamstats pull --quiet --ff-only
ExecStart=/usr/bin/hamstats-publish --push
